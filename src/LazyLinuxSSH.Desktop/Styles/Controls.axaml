<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Noto Sans, sans-serif" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Code, JetBrains Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Opacity" Value="0.78" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.compact">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.close">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="MinWidth" Value="30" />
  </Style>
  <Style Selector="Button.close:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.mode">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.mode.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Server tools switcher and saved-script cards -->
  <Style Selector="Border.tools-icon">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.3" />
  </Style>
  <Style Selector="Grid.tools-switcher">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
  </Style>
  <Style Selector="Button.tools-tab">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tools-tab.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.new-script">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.script-card">
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.script-card.selected">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
    <Setter Property="Padding" Value="8,8,10,8" />
  </Style>
  <Style Selector="Border.script-icon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.script-kind-badge">
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.script-run">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.script-run.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.script-menu">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.script-actions">
    <Setter Property="MinWidth" Value="178" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="0 10 28 0 #66000000" />
  </Style>
  <Style Selector="Button.script-action">
    <Setter Property="MinHeight" Value="35" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.script-safety">
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Padding" Value="13,10" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.command-category">
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.category-header">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.command-row">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.command-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.command-row.selected">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3,1,0,0" />
    <Setter Property="Padding" Value="9,10,12,10" />
  </Style>
  <Style Selector="Button.command-row.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBlock.command-count">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Button.password-toggle">
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="0,0,5,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton">
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- Window and workspace chrome -->
  <Style Selector="Button.window-button">
    <Setter Property="MinWidth" Value="38" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.window-close:pointerover">
    <Setter Property="Background" Value="#C42B3B" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.workspace-tab">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,3" />
  </Style>
  <Style Selector="Border.workspace-tab.active">
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.tab-main">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="13,3,6,3" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.tab-close">
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.new-tab">
    <Setter Property="MinWidth" Value="42" />
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.layout-switcher">
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Button.layout-button">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.layout-button.selected">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.toolbar-icon">
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- File editor overlay -->
  <Style Selector="Button.editor-save">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="11,3" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.editor-tool">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Empty terminal-grid cells and open-session picker -->
  <Style Selector="Button.empty-grid-slot">
    <Setter Property="MinWidth" Value="190" />
    <Setter Property="MinHeight" Value="116" />
    <Setter Property="Padding" Value="22,16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.empty-grid-plus">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.session-picker">
    <Setter Property="MinWidth" Value="250" />
    <Setter Property="MaxWidth" Value="330" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Button.session-picker-item">
    <Setter Property="MinHeight" Value="54" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Connections -->
  <Style Selector="Button.sidebar-toggle">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.sidebar-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Button.collapsed-sidebar-item">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="MinWidth" Value="42" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.collapsed-sidebar-item.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.add-connection">
    <Setter Property="MinWidth" Value="38" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="19" />
  </Style>
  <Style Selector="TextBox.search-box">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
  </Style>
  <Style Selector="TextBlock.search-hint">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Padding" Value="5,2" />
  </Style>
  <Style Selector="Button.group-header">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TextBlock.group-count">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Grid.profile-row">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Grid.profile-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.profile-connect">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="10,5,4,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.profile-action">
    <Setter Property="MinWidth" Value="25" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Margin" Value="0,0,3,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.new-connection-wide">
    <Setter Property="MinWidth" Value="218" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="20,8" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Noto Sans, sans-serif" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Saved-server picker on the start page -->
  <Style Selector="Border.server-picker">
    <Setter Property="MinWidth" Value="360" />
    <Setter Property="MaxWidth" Value="430" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 12 35 0 #66000000" />
  </Style>
  <Style Selector="Button.server-picker-item">
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.server-picker-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Start and history pages -->
  <Style Selector="Button.start-primary">
    <Setter Property="MinWidth" Value="270" />
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="Padding" Value="24,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.start-secondary">
    <Setter Property="MinWidth" Value="225" />
    <Setter Property="MinHeight" Value="43" />
    <Setter Property="Padding" Value="20,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.history-entry">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="TextBlock.history-command">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Connection editor -->
  <Style Selector="Border.connection-dialog">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="0 12 45 0 #80000000" />
  </Style>
  <Style Selector="Button.dialog-close">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.editor-input">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Noto Sans, sans-serif" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ComboBox.editor-input">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Noto Sans, sans-serif" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="NumericUpDown.editor-input">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Noto Sans, sans-serif" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.group-add">
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="Grid.auth-switcher">
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
  </Style>
  <Style Selector="Button.auth-mode">
    <Setter Property="MinHeight" Value="43" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.auth-mode.selected">
    <Setter Property="Background" Value="#294A78" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Grid.mode-switcher">
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
  </Style>
  <Style Selector="Border.advanced-panel">
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.advanced-header">
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.dialog-cancel">
    <Setter Property="MinHeight" Value="43" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.dialog-save">
    <Setter Property="MinHeight" Value="43" />
    <Setter Property="Padding" Value="20,8" />
  </Style>

  <!-- Theme icon transition and command-template settings -->
  <Style Selector="TextBlock.theme-moon">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBlock.theme-sun">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Grid.theme-icon.dark > TextBlock.theme-moon"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Grid.theme-icon.dark > TextBlock.theme-sun"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="Grid.theme-icon:not(.dark) > TextBlock.theme-moon"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="Grid.theme-icon:not(.dark) > TextBlock.theme-sun"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Border.active-template-badge">
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.settings-panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.template-list-item">
    <Setter Property="MinHeight" Value="62" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.template-list-item.selected">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.read-only-badge">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="TextBox.template-name-input">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="MinWidth" Value="280" />
  </Style>
  <Style Selector="Button.settings-section">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.settings-section.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.language-option">
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
  </Style>
  <Style Selector="Button.language-option.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.template-category-toggle">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.template-chevron">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.template-tree-category">
    <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Grid.template-command-check">
    <Setter Property="Margin" Value="0,5" />
    <Setter Property="MinHeight" Value="43" />
  </Style>
</Styles>
