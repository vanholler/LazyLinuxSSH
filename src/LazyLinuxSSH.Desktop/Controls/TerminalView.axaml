<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xaml="https://github.com/avaloniaui/avaloniaedit"
             xmlns:controls="clr-namespace:LazyLinuxSSH.Desktop.Controls"
             x:Class="LazyLinuxSSH.Desktop.Controls.TerminalView"
             Focusable="True">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource TerminalBackground}">
    <Border Grid.Row="0" Padding="12,7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <Button Content="{DynamicResource 'Очистить'}" Command="{Binding ClearCommand}" Classes="ghost compact" ToolTip.Tip="{DynamicResource 'Очистить экран терминала'}" />
          <Button Content="×" Command="{Binding CloseCommand}" Classes="ghost compact close" ToolTip.Tip="{DynamicResource 'Закрыть сессию'}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsConnected}" />
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StateLabel}" Classes="muted" FontSize="11" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Name="TerminalSurface" DragDrop.AllowDrop="True">
      <xaml:TextEditor Name="Editor"
                       Focusable="True"
                       IsReadOnly="True"
                       ShowLineNumbers="False"
                       FontFamily="Cascadia Code, JetBrains Mono, Consolas, monospace"
                       FontSize="13"
                       Padding="12"
                       Background="Transparent"
                       Foreground="{DynamicResource TerminalForeground}"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto"
                       WordWrap="True" />
      <Border IsVisible="{Binding IsReconnectOverlayVisible}" Background="#CC11161D" ZIndex="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="330">
          <TextBlock Text="{DynamicResource 'Соединение прервано'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource 'Старая сессия будет закрыта, затем терминал подключится с тем же профилем.'}"
                     TextWrapping="Wrap" TextAlignment="Center" Foreground="#D2D8E2" />
          <Button Content="{DynamicResource 'Переподключить'}" Command="{Binding ReloadCommand}" Classes="primary" HorizontalAlignment="Center" MinWidth="180" MinHeight="44" />
        </StackPanel>
      </Border>
      <Border IsVisible="{Binding IsFileDropOverlayVisible}" Background="#9911161D" ZIndex="25">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E61B2430" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="12" Padding="28,22" MinWidth="280" MaxWidth="420">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="160" Height="4" IsVisible="{Binding IsUploadInProgress}" />
            <TextBlock Text="{Binding FileDropBannerText}" FontSize="16" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Border>
      <Grid IsVisible="{Binding IsFileEditorOpen}" ZIndex="30">
        <controls:FileEditorView DataContext="{Binding FileEditor}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
